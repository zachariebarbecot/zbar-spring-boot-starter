<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>fr.zbar.it</groupId>
  <artifactId>test-scope-consumer</artifactId>
  <version>1.0</version>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>fr.zbar</groupId>
        <artifactId>zbar-bom</artifactId>
        <version>@project.version@</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>fr.zbar</groupId>
      <artifactId>zbar-test-spring-boot-starter</artifactId>
      <version>@project.version@</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>@maven-enforcer-plugin.version@</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.testcontainers:*:*:*:compile</exclude>
                    <exclude>org.testcontainers:*:*:*:runtime</exclude>
                    <exclude>org.mock-server:*:*:*:compile</exclude>
                    <exclude>org.mock-server:*:*:*:runtime</exclude>
                    <exclude>com.tngtech.archunit:*:*:*:compile</exclude>
                    <exclude>com.tngtech.archunit:*:*:*:runtime</exclude>
                    <exclude>org.springframework:*:*:*:compile</exclude>
                    <exclude>org.springframework:*:*:*:runtime</exclude>
                    <exclude>org.springframework.boot:*:*:*:compile</exclude>
                    <exclude>org.springframework.boot:*:*:*:runtime</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
